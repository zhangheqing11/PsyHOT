# HTTPS in front of the site: Caddy gets and renews the certificate for SITE_DOMAIN and compresses
# responses. Point the domain's DNS at this server first.
{$SITE_DOMAIN} {
	encode zstd gzip
	# The page-view beacon (apps/web/app/lib/page-views.ts) only needs to reach the access log.
	handle /_pv {
		respond 204
	}
	handle {
		reverse_proxy web:3000
	}
	# Access log for visit counts (deploy/stats.sh). JSON, rotated at 20 MB and kept 30 days; Caddy
	# redacts Cookie and Authorization headers. Disclosed in industry/pages/privacy.md.
	log {
		output file /data/logs/access.log {
			roll_size 20MiB
			roll_keep 30
			roll_keep_for 720h
		}
		format filter {
			# Page-view beacons URL-encode the page and referrer into p/r; filter their t too.
			# The outer filters pass URI/Referer values to this encoder by their leaf names.
			wrap filter {
				wrap json
				fields {
					uri regexp `(?i)(%3f|%26)t%3d[^%&]*` `${1}t%3DREDACTED`
					Referer regexp `(?i)(%3f|%26)t%3d[^%&]*` `${1}t%3DREDACTED`
				}
			}
			fields {
				request>uri query {
					replace t REDACTED
				}
				request>headers>Referer query {
					replace t REDACTED
				}
			}
		}
	}
}

# www.<domain> goes to the bare domain (one address for the site, so links and search results do not split).
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Other sites hosted on the same server (for example FitMyCounselor) add their own site blocks here.
# The directory is mounted by a docker-compose.override.yml outside this repo; when nothing is
# mounted the glob matches no files and Caddy only logs a warning.
import /etc/caddy/sites/*.caddy
